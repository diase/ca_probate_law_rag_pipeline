[{"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-142", "header": "Waiver of Bond by Heir or Beneficiary(DE-142)", "body": ""}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-120(PA)", "header": "Attachment to Notice of Hearing Proof of Personal Service(DE-120(PA))", "body": "Gives more space to list people who had a Notice of Hearing delivered in person to (personally served on) them.  This can be attached to either Proof of Personal Service of Notice of Hearing\u2014Decedent's Estate or Trust (DE-120(P)) or Proof of Personal Service of Notice of Hearing\u2014Guardianship or Conservatorship (GC-020 (P))."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-154", "header": "Request for Special Notice(DE-154)", "body": "Ask to get notice of more things that may be filed in a case in probate court. People who were served with a request for special notice (DE-154) also use this to tell the court they have received the request."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/GC-335", "header": "Confidential Capacity Assessment and Declaration\u2014Probate Conservatorship(GC-335)", "body": "This form is to be completed by a Physician, Psychologist or Religious Healing Practitioner to tell the court about the mental capacity of a potential conservatee."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/GC-206-INFO", "header": "Information on Probate Guardianship of the Estate(GC-206-INFO)", "body": ""}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/GC-310", "header": "Petition for Appointment of Probate Conservator(GC-310)", "body": "Ask the court to appoint a conservator of the person or the estate. This form can also be used to ask the court to appoint a new person to be the conservator in an existing case."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-111(A-3e)", "header": "Waiver of Bond by Heir or Beneficiary(DE-111(A-3e))", "body": "If you are eligible to receive part of an estate (the property of a deceased person), tell the court that you want to waive (give up) the requirement that the estate\u2019s personal representative (the person named as executor in the deceased person\u2019s will or the person appointed by the court to manage the estate of a deceased person who did not have a will) have a bond (a form of insurance in case the personal representative steals from or does not properly manage the estate). Can be attached to a Petition for Probate (DE-111)."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/GC-322", "header": "Citation\u2014Probate(GC-322)", "body": "Give notice to other parties that there will be a hearing."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-120", "header": "Notice of Hearing\u2014Decedent's Estate or Trust(DE-120)", "body": "If you file a paper in court relating to an estate or a trust, tell all interested persons about the date, time, and place of a hearing relating to that paper."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-200", "header": "Order Prescribing Notice(DE-200)", "body": "States the court\u2019s decision (order) about who must be given (served with) the Notice of Hearing."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-174", "header": "Allowance or Rejection of Creditor's Claim(DE-174)", "body": "The personal representative of the estate uses this to tell the court and a creditor who made a claim against the estate whether the representative approves or rejects the claim in whole or in part and also states the court\u2019s decision to approve or reject the claim. Also provides creditors whose claims are rejected by the personal representative with information about what they can do next."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-140", "header": "Order for Probate(DE-140)", "body": "States the courts decision (order) appointing the personal representative of an estate (the executor of the deceased person\u2019s will or the administrator appointed by the court to manage the estate of a deceased person who did not have a will) and listing powers and responsibilities of the representative."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-111", "header": "Petition for Probate(DE-111)", "body": "Ask the court to start the process for distributing a deceased person\u2019s property, paying debts owed by the deceased person, and settling the financial affairs of the deceased person."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-131", "header": "Proof of Subscribing Witness(DE-131)", "body": "A person who signed another person\u2019s will (a legal paper that lists a person\u2019s wishes about what will happen to his or her property after death) or a codicil (a change to a person\u2019s will) uses this to make a sworn statement about that will or codicil."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-161", "header": "Inventory and Appraisal Attachment(DE-161)", "body": "Gives more space to tell the court about more property owned by the estate and approximately how much it is worth. Can be attached to Inventory and Appraisal (DE-160)."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-351", "header": "Order Appointing Guardian Ad Litem\u2014Probate(DE-351)", "body": "States the court's decision (order) to appoint an adult to represent the best interests of a child in a probate case."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/GC-325", "header": "Confidential Declaration on Medical Ability to Attend Hearing\u2014Probate Conservatorship(GC-325)", "body": ""}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/GC-341", "header": "Notice of Conservatee's Rights\u2014Probate(GC-341)", "body": "Tell the conservatee about their rights and show the court that the information was served on all necessary people."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/JV-213", "header": "Probate Court Request for Juvenile Court Review of Decision not to Commence Proceedings(JV-213)", "body": ""}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/GC-205-INFO", "header": "Information on Probate Guardianship of the Person(GC-205-INFO)", "body": ""}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/APP-001-INFO", "header": "Information on Appeal Procedures for Unlimited Civil Cases(APP-001-INFO)", "body": "Explains the steps to begin and complete an appeal of a trial court in an unlimited civil case (generally a case for more than $25,000 or a case from family, juvenile, or probate court). It includes links to online resources to help understand each step in the appeal process."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/GC-248", "header": "Duties of Guardian (Probate)(GC-248)", "body": "Explains the duties and responsibilities of a person appointed as guardian of a person or an estate and must be signed to prove the guardian received a copy."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-121(MA)", "header": "Attachment to Notice of Petition to Administer Estate\u2014Proof of Service by Mail(DE-121(MA))", "body": "Gives more space to list people who had a Notice of Petition to Administer Estate (DE-121) delivered to (served on) them by mail. This can be attached to Notice of Petition to Administer Estate (DE-121)."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-275", "header": "Ex Parte Petition for Approval of Sale of Personal Property and Order(DE-275)", "body": "A personal representative of the estate, conservator, or guardian uses this to ask the court for permission, without holding a hearing, to sell personal property in an estate, guardianship of the estate, or conservatorship case. Can also be used by the court to state its decision (order) approving the sale."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-315", "header": "Order Determining Succession to Primary Residence(DE-315)", "body": "States the court\u2019s decision (order) that the value of all the property in California in a deceased person\u2019s estate is $166,250 or less, the estate does not have to go through the probate process, and that the deceased person\u2019s real property belongs to those who filed a Petition to Determine Succession to Real Property (Estates of $166,250 or Less) (DE-310). Can also be used to order that the deceased person\u2019s personal property belongs to the petitioners."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/GC-335A", "header": "Everyday Activities Attachment to Confidential Capacity Assessment and Declaration\u2014Probate Conservatorship(GC-335A)", "body": "This form is to be completed by a Physician, Psychologist or Religious Healing Practitioner to tell the court about the mental capacity of a potential conservatee who is suffering from dementia. This form must be attached to form GC-335."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-147", "header": "Duties and Liabilities of Personal Representative(DE-147)", "body": "Explains the duties of a personal representative of an estate (the executor of the deceased person\u2019s will or the administrator appointed by the court to manage the estate of a deceased person who did not have a will) and what can happen if a personal representative does not fulfill those duties. People who have asked the court to be appointed as a personal representative also use this to tell the court they have received a copy of Duties and Liabilities of Personal Representative (DE-147)."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-295", "header": "Ex Parte Petition for Final Discharge and Order(DE-295)", "body": "A personal representative of the estate, conservator, or guardian uses this to tell the court that all property in an estate, guardianship of the estate, or conservatorship case has been distributed, transferred or sold according to the court's prior orders and to ask the court to order, without holding a hearing, that the person is no longer (is discharged from being) the personal representative of the estate, conservator, or guardian. Can also be used by the court to state its decision (order) approving the discharge of the personal representative of the estate, conservator, or guardian."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-157", "header": "Notice of Administration to Creditors(DE-157)", "body": "Tells those to whom a deceased person owes money or other property (creditors) who has been appointed as the personal representative of the deceased person\u2019s estate and that the representative has started managing the estate. Also provides creditors with information about how and when to make a claim against the estate and what may happen if they do not file a claim on time."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-121", "header": "Notice of Petition to Administer Estate(DE-121)", "body": "If you file a Petition for Probate (a request to start the process for distributing a deceased person\u2019s property, paying debts owed by the deceased person, and settling the financial affairs of the deceased person), tell all interested persons that the petition has been filed and about the date, time, and place of a hearing on the petition. Also explains what a person receiving the notice should do if they do not agree with the petition."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/GC-341(MA)", "header": "Attachment to Notice of Conservatee's Rights\u2014Probate(GC-341(MA))", "body": "Tell the court about additional people who were served by mail with the Notice of Conservatee's Rights. This form must be attached to form GC-341."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-125", "header": "Summons (Probate)(DE-125)", "body": "Tells  parties other than the petitioner that a probate case has started and what can happen if a response is not filed in 30 days."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-147(S)", "header": "Confidential Supplement to Duties and Liabilities of Personal Representative(DE-147(S))", "body": "People who have asked a court to be appointed as a personal representative of an estate  use this to confidentially give a court that requires it their birth date and driver\u2019s license number."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-350", "header": "Petition for Appointment of Guardian Ad Litem\u2014Probate(DE-350)", "body": "Ask the court to appoint an adult to represent the best interests of a child to the court in a probate case."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-120(MA)", "header": "Attachment to Notice of Hearing Proof of Service by Mail(DE-120(MA))", "body": "Gives more space to list people who had a Notice of Hearing delivered to (served on) them by mail.  This can be attached to either Notice of Hearing\u2014Guardianship or Conservatorship (GC-020) or Notice of Hearing-Decedent\u2019s Estate or Trust (DE-120)."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-122", "header": "Citation\u2014Probate(DE-122)", "body": "Tells a person that they are required to come to a hearing relating to a case in probate court, such as a case about an estate (the property of a deceased person) or a trust (an arrangement where property is given to someone to be held for the benefit of another person)."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/GC-342", "header": "Personalized Information for Conservatee\u2014Probate(GC-342)", "body": "Gives the conservatee personalized information about their conservatorship, including which rights they lose and which rights they keep."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-120(P)", "header": "Proof of Personal Service of Notice of Hearing\u2014Decedent's Estate or Trust(DE-120(P))", "body": "Tell the court who had a Notice of Hearing-Decedent\u2019s Estate or Trust (DE-120) delivered in person to (personally served on) them. This can be attached to Notice of Hearing-Decedent\u2019s Estate or Trust (DE-120)."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-115", "header": "Notice of Hearing on Petition to Determine Claim to Property(DE-115)", "body": "A person who made a claim to property that is in an estate or a trust or that will be distributed by a guardianship or conservatorship uses this to tell all interested persons about the date, time, and place of a hearing relating to that claim. Also tells those receiving the notice what might happen if they do not come to the hearing or respond to the claim."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-221", "header": "Spousal or Domestic Partner Property Petition (Probate\u2014Decedents Estates)(DE-221)", "body": "Ask the court to decide that all or part of a deceased person\u2019s estate does not have to go through the probate process because it belongs to the deceased person\u2019s spouse or domestic partner."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-300", "header": "Maximum Values For Small Estate Set-Aside & Disposition of Estate Without Administration(DE-300)", "body": ""}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-310", "header": "Petition to Determine Succession to Primary Residence(DE-310)", "body": "Make a sworn statement to the court that the value of all the property in California in a deceased person\u2019s estate is $166,250 or less and ask the court, without going through the probate process, to decide that you (and anyone else making the request) should get the deceased person\u2019s real property because you are a beneficiary in the deceased person\u2019s will or an heir of a the person who died without a will. Can also be used to ask the court for the deceased person\u2019s personal property."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/GC-101", "header": "Order Appointing Guardian Ad Litem\u2014Probate(GC-101)", "body": "States the court's decision to appoint an adult to represent the best interests of a child in a probate case."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-160", "header": "Inventory And Appraisal(DE-160)", "body": "Tells the court what property is owned by the estate and approximately how much it is worth."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-265", "header": "Order Confirming Sale of Real Property(DE-265)", "body": "States the court's decision (order) whether to confirm the sale of real property in an estate, guardianship of the estate, or conservatorship case."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-270", "header": "Ex Parte Petition for Authority to Sell Securities and Order(DE-270)", "body": "A personal representative of the estate, conservator, or guardian uses this to ask the court to approve, without a hearing, the sale of securities in an estate, guardianship of the estate, or conservatorship case. Can also be used by the court to state its decision (order) approving the sale."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/GC-210(CA)", "header": "Child Information Attachment to Probate Guardianship Petition(GC-210(CA))", "body": "Tell the court if you are a professional fiduciary and are asking the court for appointment as guardian or conservator. This form must be attached to form GC-210 or form GC-310."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-150", "header": "Letters(DE-150)", "body": "Persons who are appointed as personal representatives of estates use this to prove to others that they need to work with to carry out their duties that they have been officially appointed by the court."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/GC-100", "header": "Petition for Appointment of Guardian Ad Litem\u2014Probate(GC-100)", "body": "Ask the court to appoint an adult to represent the best interests of a child to the court in a probate case."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/GC-340", "header": "Order Appointing Probate Conservator(GC-340)", "body": "States the court's decision to appoint a conservator."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-226", "header": "Spousal or Domestic Partner Property Order (Probate\u2014Decedents Estates)(DE-226)", "body": "States the courts decision (order) about whether all or part of a deceased person\u2019s estate does not have to go through the probate process because it belongs to the deceased person\u2019s spouse or domestic partner."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-305", "header": "Affidavit Re Real Property of Small Value(DE-305)", "body": "Make a sworn statement to the court that the value of all real property in California in a deceased person\u2019s estate is $55,425 or less."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-166", "header": "Waiver of Notice of Proposed Action(DE-166)", "body": "Tell the court that you give up (waive) your right to get notice from the personal representative of the estate about actions that the representative plans to take. Can also be used to cancel (revoke) a waiver of the right to notice that you signed before."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-135", "header": "Proof of Holographic Instrument(DE-135)", "body": "A person who is familiar with the handwriting of a deceased person uses this to make a sworn statement that handwritten parts of a will were written and signed by the deceased person."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-165", "header": "Notice of Proposed Action (Objection-Consent)(DE-165)", "body": "Personal representatives of estates use this to tell all interested persons about actions that they plan to take. Also used by people receiving the notice to tell the court if they disagree with (object to) or agree with (consent to) the representative\u2019s proposed action."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-172", "header": "Creditor's Claim(DE-172)", "body": "Those to whom a deceased person owes money or other property (creditors) use this to make a claim against the estate.  Also explains how to fill out the claim, when and how to file it, and what may happen if it is not filed on time."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/APP-002", "header": "Notice of Appeal/Cross-Appeal\u2014Unlimited Civil Case(APP-002)", "body": "Tell the trial court that you are appealing (asking a higher court to review) the decision (final judgment or order) of the trial court in an unlimited civil case (generally a case for more than $25,000 or a case from family, juvenile, or probate court)."}, {"source": "https://selfhelp.courts.ca.gov//jcc-form/DE-260", "header": "Report of Sale and Petition for Order Confirming Sale of Real Property(DE-260)", "body": "A personal representative of the estate, conservator, or guardian uses this to tell the court about the sale of real property in an estate, guardianship of the estate, or conservatorship case and ask the court to confirm the sale."}]